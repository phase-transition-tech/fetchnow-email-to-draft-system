# 复制成 .env 后填真值。.env 已在 .gitignore 里，别提交。
# （.env 会自动加载，不用再写 --env-file=.env；shell 里 export 的 FN_* 优先于这里的值）

# ---- 收件（阶段三，IMAP）----
# 用 Gmail 的话：
#   1. 新版 Gmail 已经没有「启用 IMAP」开关了，IMAP 默认就是开的，
#      设置 → 转发和 POP/IMAP 那页只需保持 POP 停用 + 删除策略「停用自动清除」+「归档邮件」
#   2. 账号开两步验证（App Password 的前置条件），再到 myaccount.google.com/apppasswords 生成「应用专用密码」
#   3. FN_IMAP_USER 填完整邮箱地址，FN_IMAP_PASS 填那串 16 位专用密码
#      （Google 显示为 xxxx xxxx xxxx xxxx，带空格也没关系，配置层会自动剥掉）
# **不要填账号登录密码**，Google 会直接拒绝 AUTH。
# host/port 用 Gmail 默认值即可（imap.gmail.com / 993 / SSL 已写死在 config/default.json），
# 下面的两行只是让你看清走的哪里；换邮箱服务商时才需要真的改。
FN_IMAP_USER=
FN_IMAP_PASS=
FN_IMAP_HOST=imap.gmail.com
FN_IMAP_PORT=993

# ---- 交付（阶段二，真 Xero）----
# Xero 后台创建 Private/Public app 后拿到；secret 不放仓库
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# 授权回调里拿到的代码，只用于换一次 token（或设 XERO_AUTH_CODE）
XERO_AUTH_CODE=
# 授权完成后在 Xero「已连接的 App」里复制 Tenant Id
XERO_TENANT_ID=

# ---- 覆盖项（可选）----
# FN_XERO_PROVIDER=mock|xero
# FN_LINE_AMOUNT_TYPES=Inclusive
# FN_DATA_DIR=/abs/path/data
# 换邮箱服务商时按需：
# FN_IMAP_SECURE=false          # 自签证书/STARTTLS 的 dovecot 才需要
