{
  "storage": {
    "dir": "data",
    "attachmentsDir": "data/attachments",
    "draftsDir": "data/xero-drafts"
  },

  "ingest": {
    "mode": "both",
    "folder": { "path": "fixtures/inbox" },
    "folderBackfillDays": 7,
    "pollIntervalMs": 300000,
    "imap": {
      "host": "imap.gmail.com",
      "port": 993,
      "secure": true,
      "user": "",
      "pass": "",
      "authMethod": "password",
      "mailbox": "INBOX",
      "idle": true,
      "maxIdleTimeMs": 1500000,
      "backfillDays": 7,
      "incrementalWindowMinutes": 5,
      "connectionTimeoutMs": 30000,
      "reconnectBackoffMs": [2000, 10000, 30000, 120000, 600000],
      "statePath": "data/imap-state.json"
    }
  },

  "filters": {
    "allowedSenderDomains": [],
    "allowedAttachmentTypes": ["application/pdf"],
    "maxAttachmentBytes": 10485760,
    "minTextConfidenceChars": 32
  },

  "extract": {
    "ocrEnabled": false,
    "ocrProvider": "stub",
    "defaultCurrency": "NZD"
  },

  "validation": {
    "amountTolerance": 0.01,
    "allowedTaxRates": [0.01, 0.03, 0.05, 0.06, 0.09, 0.1, 0.13, 0.15],
    "maxDaysToDueDate": 120
  },

  "xero": {
    "provider": "mock",
    "baseUrl": "https://api.xero.com/api/v3.0",
    "authUrl": "https://login.xero.com/authorize",
    "tokenUrl": "https://identity.xero.com/connect/token",
    "clientId": "",
    "clientSecret": "",
    "redirectUri": "http://127.0.0.1:54545/callback",
    "scope": "openid profile email offline_access accounting.contacts accounting.transactions",
    "lineAmountTypes": "Inclusive",
    "defaultTaxCode": "INPUT",
    "defaultAccountCode": "600",
    "tokenPath": "data/xero-token.json",
    "checkExisting": true,
    "expirySkewSec": 300
  },

  "worker": {
    "concurrency": 1,
    "maxAttempts": 3,
    "backoffMs": [5000, 15000, 45000]
  },

  "review": {
    "autoCreateWhen": "no-flags",
    "autoAdmitDomains": []
  }
}
